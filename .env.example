# ---------------------------------------------------------------------------
# condoplus — variáveis de ambiente
# Copie para `.env` (desenvolvimento) ou para o `.env` da VPS (produção, chmod 600).
# ---------------------------------------------------------------------------

# Banco (dev: docker-compose.yml expõe o Postgres em 127.0.0.1:55432)
DATABASE_URL=postgresql://condoplus:condoplus@127.0.0.1:55432/condoplus

# URL pública da aplicação (usada pelo Better Auth, links de e-mail e cookies)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Segredo de sessão — gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-este-segredo-em-producao-com-32-bytes

# Admin Master (criado/atualizado na inicialização e no seed)
MASTER_EMAIL=master@condoplus.local
MASTER_PASSWORD=master123456
MASTER_NAME=Admin Master

# Storage de arquivos: "local" (pasta STORAGE_LOCAL_DIR) ou "s3" (MinIO, R2, OCI, AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/uploads
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=condoplus
S3_ACCESS_KEY=condoplus
S3_SECRET_KEY=condoplus-dev-secret
S3_FORCE_PATH_STYLE=true

# Limite de upload por arquivo, em MB
UPLOAD_MAX_MB=20

# E-mail: "console" (dev), "smtp" ou "resend".
# A OCI bloqueia a porta 25: use 587/465 de um provedor ou a API do Resend.
EMAIL_PROVIDER=console
EMAIL_FROM="condoplus <nao-responda@exemplo.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
